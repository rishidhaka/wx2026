{
  "name": "wc2026-tests",
  "version": "1.0.0",
  "description": "Test suite for FIFA 2026 Prediction League",
  "scripts": {
    "test": "jest --verbose",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "testMatch": ["**/*.test.js"],
    "collectCoverageFrom": [
      "*.test.js"
    ]
  }
}
