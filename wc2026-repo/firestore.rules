rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── PLAYERS ──────────────────────────────────────────────────────────
    // Each player can only read all (for leaderboard) but write only their own entry
    match /wc2026/players {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        // Must write exactly one key — their own UID
        && request.resource.data.keys().hasOnly([request.auth.uid])
        // Name must match their actual Google display name (prevents spoofing)
        && request.resource.data[request.auth.uid].name is string
        && request.resource.data[request.auth.uid].name == request.auth.token.name;
    }

    // ── RESULTS ──────────────────────────────────────────────────────────
    // Everyone can read (needed for score calculation)
    // Only the admin UID can write
    match /wc2026/results {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.uid == "YOUR_ADMIN_UID_HERE"; // ← replace this
    }

    // ── LEAGUES ──────────────────────────────────────────────────────────
    // Any authenticated user can read and write leagues
    // Client-side validation handles the join/create rules
    // (Cannot remove members, cannot change creator — enforced in app logic)
    match /wc2026/leagues {
      allow read:  if request.auth != null;
      allow write: if request.auth != null;
    }

    // ── TOURNAMENT DATA ───────────────────────────────────────────────────
    // Written only by Cloud Function (service account bypasses rules)
    // Clients can read, never write
    match /wc2026/tournament {
      allow read:  if request.auth != null;
      allow write: if false;
    }

    // ── COMPUTED SCORES ───────────────────────────────────────────────────
    // Written only by Cloud Function
    match /wc2026/scores {
      allow read:  if request.auth != null;
      allow write: if false;
    }

    // ── PER-USER PICKS ────────────────────────────────────────────────────
    // Each user can only read and write their own picks document
    match /wc2026picks/{userId} {
      allow read:  if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // ── CATCH-ALL DENY ────────────────────────────────────────────────────
    // Block access to any other documents not explicitly listed
    match /{document=**} {
      allow read, write: if false;
    }

  }
}
